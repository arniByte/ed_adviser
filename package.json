{
  "name": "chernovik",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI-тренажёр для абитуриента и стажёра: справка с источниками и разбор ответов в роли наставника",
  "scripts": {
    "dev": "vite",
